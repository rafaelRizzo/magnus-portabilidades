# IP publico do servidor Magnus (destino dos INVITEs na porta 5060)
SERVER_IP=203.0.113.1
# Opcional: dominio SIP mostrado em "Host" no Copiar dados. Se vazio, usa o SERVER_IP.
SIP_HOST=
# Token Bearer da API local (minimo 16 caracteres)
API_TOKEN=troque-por-um-token-longo
API_PORT=3100

DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Opcionais: se vazios, qualquer cargo/canal pode usar o comando
ALLOWED_ROLE_ID=
ALLOWED_CHANNEL_ID=

# Opcional: MySQL do Magnus. Mostra cliente e destino na resposta. Para o /inativar, o usuario precisa dos grants extras do README.
# Caracteres especiais na senha precisam de URL encode.
# Ex: mysql://portab:senha@127.0.0.1:3306/mbilling
MAGNUS_DB_URL=
